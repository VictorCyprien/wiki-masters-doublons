{
  "manifest_version": 3,
  "name": "Doublons pour Wiki Masters (non officiel)",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Trouve tes cartes en double sur Wiki Masters : un choix « Doublons » apparaît dans le tri de ta collection.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Doublons pour Wiki Masters",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.wiki-masters.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "src/site-api.js",
        "src/duplicates.js",
        "src/mutations.js",
        "src/loader.js",
        "src/cache.js",
        "src/interceptor.js",
        "src/controller.js",
        "src/format.js",
        "src/log.js",
        "src/dom.js",
        "src/main.js"
      ]
    }
  ]
}
